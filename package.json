{
  "name": "svec-lab-scheduler",
  "version": "1.0.0",
  "description": "Sri Vasavi Engineering College - Laboratory Scheduling & Booking Web Application",
  "main": "server/src/server.js",
  "scripts": {
    "server": "node server/src/server.js",
    "server:dev": "nodemon server/src/server.js",
    "seed": "node server/src/seed.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js"
  },
  "keywords": [
    "svec",
    "lab-scheduler",
    "college",
    "booking",
    "react",
    "express"
  ],
  "author": "SVEC Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "nodemon": "^3.1.14"
  }
}
